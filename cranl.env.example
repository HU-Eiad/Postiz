# ---------------------------------------------------------------------------
# Postiz environment variables for CranL
# Paste into: App -> Environment tab -> Raw Mode
#
# Values marked <<< FILL IN >>> must be replaced before the app will boot.
# DATABASE_URL and REDIS_URL are injected automatically by CranL when you
# create the managed Postgres and Redis with "Inject into App" enabled --
# do NOT paste them here, or you will overwrite the injected values.
# ---------------------------------------------------------------------------

# === Public URLs ===========================================================
# Use the free CranL subdomain first, then switch all three to your custom
# domain once DNS is verified. All three must be the SAME https origin.
MAIN_URL=https://<<< FILL IN >>>.cranl.net
FRONTEND_URL=https://<<< FILL IN >>>.cranl.net
NEXT_PUBLIC_BACKEND_URL=https://<<< FILL IN >>>.cranl.net/api

# Internal loopback to the NestJS backend inside the container. Leave as-is.
BACKEND_INTERNAL_URL=http://localhost:3000

# === Secrets ===============================================================
# Generate with: openssl rand -hex 48        (or scripts/gen-secret.sh)
# Changing this later invalidates every existing login session.
JWT_SECRET=<<< FILL IN >>>

# === Temporal Cloud ========================================================
# CranL has no managed Temporal and no app-to-app private networking, so the
# Temporal server must be external. Postiz requires it -- the backend's root
# AppModule imports the Temporal module, so it will not boot without one.
# Address format: <namespace>.<account-id>.<region>.<cloud>.api.temporal.io:7233
TEMPORAL_ADDRESS=<<< FILL IN >>>:7233
TEMPORAL_NAMESPACE=<<< FILL IN >>>
TEMPORAL_API_KEY=<<< FILL IN >>>
TEMPORAL_TLS=true

# === Media storage (CranL Storage bucket) ==================================
# Uses our patched image (see Dockerfile + .github/workflows/build-image.yml),
# which adds S3_ENDPOINT. Stock Postiz hardcodes the Cloudflare R2 endpoint.
#
# Local disk is not an option: CranL apps have no persistent volume, so
# uploads would vanish on every redeploy.
STORAGE_PROVIDER=cloudflare

# From the CranL bucket detail page. No trailing slash.
S3_ENDPOINT=https://<<< FILL IN: CranL S3 endpoint >>>
# Most non-AWS S3 implementations address buckets as <endpoint>/<bucket>.
# If uploads fail with NoSuchBucket or DNS errors, this is the first thing
# to flip to false.
S3_FORCE_PATH_STYLE=true

# CranL bucket name and the S3 credentials you created on that bucket.
CLOUDFLARE_BUCKETNAME=<<< FILL IN: bucket name >>>
CLOUDFLARE_ACCESS_KEY=<<< FILL IN: access key >>>
CLOUDFLARE_SECRET_ACCESS_KEY=<<< FILL IN: secret key >>>
CLOUDFLARE_REGION=auto

# Public base URL that media is served from (the bucket CDN URL shown on the
# bucket page). NO trailing slash -- Postiz appends the '/' itself, so a
# trailing slash produces broken // URLs.
CLOUDFLARE_BUCKET_URL=https://<<< FILL IN: public bucket/CDN URL >>>

# Unused when S3_ENDPOINT is set, but Postiz still interpolates it into the
# fallback endpoint string, so leave it non-empty.
CLOUDFLARE_ACCOUNT_ID=unused

# === Mode ==================================================================
# IS_GENERAL=true selects self-hosted mode (no Stripe/billing gates).
IS_GENERAL=true
# Set to true after you have registered your own account, so the public
# instance cannot be signed up for by anyone who finds the URL.
DISABLE_REGISTRATION=false
NODE_ENV=production
API_LIMIT=30
NX_ADD_PLUGINS=false

# === Optional: AI features =================================================
# OPENAI_API_KEY=

# === Optional: social provider credentials =================================
# Add only the networks you actually connect. Each needs its OAuth callback
# registered as: <MAIN_URL>/integrations/social/<provider>
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN_ID=
# SLACK_ID=
# SLACK_SECRET=
# SLACK_SIGNING_SECRET=
# MASTODON_URL=https://mastodon.social
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
