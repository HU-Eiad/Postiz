# ---------------------------------------------------------------------------
# Postiz v2.11.3 environment variables for CranL
# Paste into: App -> Environment tab -> Raw Mode
#
# v2.11.3 is the last release that uses BullMQ (on Redis) rather than Temporal,
# so it needs no external workflow service -- just the Postgres and Redis that
# CranL provides. v2.12.0 onward require a Temporal server.
#
# Values marked <<< FILL IN >>> must be replaced before the app will boot.
# ---------------------------------------------------------------------------

# === Databases =============================================================
# From each database's detail page in CranL. Both must be in the SAME region
# as the app (Riyadh) or Prisma will fail to connect at boot.
DATABASE_URL=<<< FILL IN: postiz-postgres connection string >>>
REDIS_URL=<<< FILL IN: postiz-redis connection string >>>

# === Secret ================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Set this ONCE before your first login -- changing it later signs everyone out.
JWT_SECRET=<<< FILL IN >>>

# === Public URLs ===========================================================
# All three must be the SAME https origin. Switch them to your custom domain
# once DNS is verified, then redeploy.
MAIN_URL=https://postiz-vx2q7m.cranl.net
FRONTEND_URL=https://postiz-vx2q7m.cranl.net
# Must keep the /api suffix: nginx in the container maps /api/ -> backend:3000.
NEXT_PUBLIC_BACKEND_URL=https://postiz-vx2q7m.cranl.net/api

# Internal loopback to the NestJS backend inside the container. Leave as-is.
BACKEND_INTERNAL_URL=http://localhost:3000

# === Media storage (CranL S3 bucket) =======================================
# Requires the patched image built by .github/workflows/build-image.yml --
# stock Postiz hardcodes the Cloudflare R2 endpoint and ignores S3_ENDPOINT.
#
# Local disk is not an option: CranL apps have no persistent volume, so
# uploads would vanish on every redeploy.
STORAGE_PROVIDER=cloudflare

# From the CranL bucket detail page. NO trailing slash.
S3_ENDPOINT=<<< FILL IN: CranL S3 endpoint >>>

# Most non-AWS S3 backends address buckets as <endpoint>/<bucket>. If uploads
# fail with NoSuchBucket or a DNS error, flip this to false first.
S3_FORCE_PATH_STYLE=true

CLOUDFLARE_BUCKETNAME=<<< FILL IN: bucket name >>>
CLOUDFLARE_ACCESS_KEY=<<< FILL IN: access key >>>
CLOUDFLARE_SECRET_ACCESS_KEY=<<< FILL IN: secret key >>>
CLOUDFLARE_REGION=auto

# Public base URL media is served from (the bucket's CDN / public URL).
# NO trailing slash -- Postiz appends the '/' itself, so one here produces
# broken // URLs.
CLOUDFLARE_BUCKET_URL=<<< FILL IN: public bucket/CDN URL >>>

# Unused once S3_ENDPOINT is set, but Postiz still interpolates it into the
# fallback endpoint string, so leave it non-empty.
CLOUDFLARE_ACCOUNT_ID=unused

# === Mode ==================================================================
IS_GENERAL=true
NODE_ENV=production
NX_ADD_PLUGINS=false
API_LIMIT=30
# Set to true after you have registered your own account, so the public
# instance cannot be signed up for by anyone who finds the URL.
DISABLE_REGISTRATION=false

# === Optional: AI features =================================================
# OPENAI_API_KEY=

# === Optional: email (user activation) =====================================
# If RESEND_API_KEY is set, new users must activate by email. Leave it unset
# and users are activated automatically.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=

# === Optional: social provider credentials =================================
# Add only the networks you actually connect. Each needs its OAuth callback
# registered as: <MAIN_URL>/integrations/social/<provider>
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN_ID=
# SLACK_ID=
# SLACK_SECRET=
# SLACK_SIGNING_SECRET=
# MASTODON_URL=https://mastodon.social
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
